# Every image must be pinned by sha256 digest before deployment.
POSTGRES_IMAGE=postgres:15-alpine@sha256:REPLACE_ME
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_ME
NGINX_IMAGE=nginx:stable-alpine@sha256:REPLACE_ME
GOSSO_IMAGE=ghcr.io/rushairer/gosso@sha256:REPLACE_ME
GOSSO_ADMIN_FRONTEND_IMAGE=ghcr.io/rushairer/gosso-admin-frontend@sha256:REPLACE_ME
GOSSO_ADMIN_SEED_IMAGE=ghcr.io/rushairer/gosso-admin-seed@sha256:REPLACE_ME

POSTGRES_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
GOSSO_SIGNING_KEY_FILE=./secrets/private.pem
GOUNO_AUTH_ISSUER=https://sso.example.com
GOUNO_AUTH_LOGIN_URL=/login
GOUNO_AUTH_TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GOUNO_AUTH_VERIFY_HASH_PEPPER=REPLACE_WITH_UNIQUE_SECRET
GOUNO_CORS_ALLOWED_ORIGINS=["https://sso.example.com"]
GOUNO_WEB_SERVER_TRUSTED_PROXIES=["10.0.0.0/8"]

GOUNO_SMTP_HOST=smtp.example.com
GOUNO_SMTP_PORT=587
GOUNO_SMTP_USERNAME=REPLACE_ME
GOUNO_SMTP_PASSWORD=REPLACE_ME
GOUNO_SMTP_FROM=noreply@example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_INITIAL_PASSWORD
ADMIN_DISPLAY_NAME=System Admin
GOSSO_SCHEMA_VERSION=20
GOSSO_ADMIN_ALLOW_INTERNAL_PLAINTEXT_DATASTORE=true
